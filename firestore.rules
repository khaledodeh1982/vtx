rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السكربتات العامة
    match /scripts/{id} {
      allow read, create, delete: if true;
    }
    // الكودات: المستخدم يقدر يزيد عداد الاستخدام بواحد فقط وضمن الحد
    match /codes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && (resource.data.maxUses == 0 || resource.data.uses < resource.data.maxUses);
    }
  }
}
